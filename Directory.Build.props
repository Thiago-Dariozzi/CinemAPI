<Project>
  <!-- Configuración común a todos los proyectos de la solución. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Analizadores de .NET y reglas de estilo del .editorconfig aplicadas al compilar. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Necesario para que IDE0005 (usings sin uso) se reporte en el build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Cualquier warning nuevo rompe el build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Excepción temporal: vulnerabilidad de System.Security.Cryptography.Pkcs (transitiva de
         Microsoft.Data.SqlClient vía EF Core SqlServer). Corregirla exige una referencia directa al
         paquete; pendiente de decisión (ver docs/auditoria-backend.md #47). Quitar al resolverla. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
